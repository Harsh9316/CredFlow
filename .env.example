# Postgres. `npm run db:up` starts one in Docker matching this URL.
DATABASE_URL="postgresql://credrail:credrail@localhost:5432/credrail"

# Signs session cookies. Required, at least 32 characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=""

# Shows the seeded demo logins on the sign-in page. Never enable in production.
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS="false"

# External data providers (see docs/CONNECTORS.md). Mock providers return deterministic
# fake data for development and demos; never use them for real decisions.
CONNECTOR_BUREAU="none"      # none | mock | gateway
CONNECTOR_GST="none"         # none | mock | setu
CONNECTOR_KYC="none"         # none | mock | setu
CONNECTOR_BANK_DATA="none"   # none | mock | setu   (Account Aggregator: bank statements, GST returns)
# With NODE_ENV=production, mock providers are refused unless this is true (demos only)
ALLOW_MOCK_CONNECTORS="false"

# Setu (https://bridge.setu.co). sandbox | production
SETU_ENV="sandbox"
SETU_AA_CLIENT_ID=""
SETU_AA_CLIENT_SECRET=""
SETU_AA_PRODUCT_INSTANCE_ID=""
# Where the borrower returns after approving a consent (optional)
SETU_AA_REDIRECT_URL=""
# Secret in the notification URL: https://<host>/api/connectors/setu/notifications/<secret>
# At least 16 characters. Generate one with: openssl rand -hex 24
SETU_AA_WEBHOOK_SECRET=""
SETU_DATA_CLIENT_ID=""
SETU_DATA_CLIENT_SECRET=""
SETU_GST_PRODUCT_INSTANCE_ID=""
SETU_PAN_PRODUCT_INSTANCE_ID=""

# Bureau gateway run by the lender (contract in docs/CONNECTORS.md)
BUREAU_GATEWAY_URL=""
BUREAU_GATEWAY_TOKEN=""

# Allow webhook endpoints on localhost / private networks. Development only.
WEBHOOK_ALLOW_PRIVATE_URLS="false"

