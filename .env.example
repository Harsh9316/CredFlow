# Postgres. `npm run db:up` starts one in Docker matching this URL.
DATABASE_URL="postgresql://credflow:credflow@localhost:5432/credflow"

# Signs session cookies. Required, at least 32 characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=""

# Shows the seeded demo logins on the sign-in page. Never enable in production.
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS="false"

# External data providers: none | mock (see lib/connectors). Mock providers return
# deterministic fake data for development and demos; never use them for real decisions.
CONNECTOR_BUREAU="none"
CONNECTOR_GST="none"
CONNECTOR_KYC="none"
CONNECTOR_BANK_DATA="none"

# Allow webhook endpoints on localhost / private networks. Development only.
WEBHOOK_ALLOW_PRIVATE_URLS="false"

