{
  "name": "credflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && npm run typecheck -w @credflow/engine",
    "db:seed": "tsx seed.ts",
    "setup": "prisma migrate deploy && tsx seed.ts",
    "test": "npm run test -w @credflow/engine && vitest run",
    "build:engine": "npm run build -w @credflow/engine",
    "policy": "tsx scripts/policy.ts",
    "policy:sync-default": "tsx scripts/generate-default-policy.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:up": "docker compose up -d db",
    "webhooks:dispatch": "tsx scripts/dispatch-webhooks.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.1",
    "jose": "^5.10.0",
    "next": "16.1.6",
    "prisma": "^5.22.0",
    "react": "19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ]
}
