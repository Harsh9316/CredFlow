// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== CORE ENTITIES ====================

// Multi-tenant NBFC organization
model NBFC {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  licenseNo String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  // Last application sequence number issued; incremented atomically per application
  applicationSeq Int @default(0)

  users            User[]
  borrowers        Borrower[]
  loanApplications LoanApplication[]
  creditPolicies   CreditPolicy[]
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  webhookEvents    WebhookEvent[]
  idempotencyKeys  IdempotencyKey[]
}

// User with role-based access
// Role: ADMIN | ANALYST | VIEWER
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ANALYST")
  nbfcId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  nbfc             NBFC       @relation(fields: [nbfcId], references: [id])
  approvals        Approval[] @relation("ApprovalMaker")
  checkedApprovals Approval[] @relation("ApprovalChecker")
  auditLogs        AuditLog[]
  apiKeysCreated   ApiKey[]
}

// ==================== BORROWER & LOAN ====================

// SME borrower profile
model Borrower {
  id             String   @id @default(cuid())
  nbfcId         String
  businessName   String
  legalName      String?
  pan            String?
  gstin          String?
  industry       String
  subIndustry    String?
  constitution   String // Proprietorship, Partnership, LLP, Pvt Ltd, etc.
  vintage        Int // Months in business
  annualTurnover Float?
  employeeCount  Int?
  address        String?
  city           String?
  state          String?
  pincode        String?
  contactPerson  String
  contactPhone   String
  contactEmail   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  nbfc             NBFC              @relation(fields: [nbfcId], references: [id])
  loanApplications LoanApplication[]
  financialData    FinancialData[]
}

// Loan application (LOS-Lite)
// Status: APPLIED | UNDER_REVIEW | PENDING_DOCS | APPROVED | REJECTED | SANCTIONED | WITHDRAWN
// Priority: LOW | NORMAL | HIGH | URGENT
model LoanApplication {
  id              String    @id @default(cuid())
  applicationNo   String    @unique
  nbfcId          String
  borrowerId      String
  requestedAmount Float
  requestedTenure Int // Months
  purpose         String?
  status          String    @default("APPLIED")
  sourcePlatform  String? // ERP, POS, Direct, etc.
  sourceReference String?
  priority        String    @default("NORMAL")
  assignedTo      String?
  appliedAt       DateTime  @default(now())
  reviewedAt      DateTime?
  decidedAt       DateTime?
  sanctionedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  nbfc           NBFC            @relation(fields: [nbfcId], references: [id])
  borrower       Borrower        @relation(fields: [borrowerId], references: [id])
  collateral     Collateral?
  creditDecision CreditDecision?
  approval       Approval?
  auditLogs      AuditLog[]
}

// ==================== FINANCIAL ANALYSIS ====================

// Financial data for analysis
model FinancialData {
  id          String   @id @default(cuid())
  borrowerId  String
  dataType    String // BANK_STATEMENT, ERP_INVOICE, GST_RETURN
  periodStart DateTime
  periodEnd   DateTime

  // Bank statement metrics
  totalCredits       Float?
  totalDebits        Float?
  avgMonthlyInflow   Float?
  avgMonthlyExpenses Float?
  freeCashFlow       Float?
  inflowVolatility   Float? // Coefficient of variation

  // Invoice metrics
  totalInvoiceValue Float?
  avgInvoiceValue   Float?
  invoiceCount      Int?

  // Cash flow analysis
  monthlyData String? // JSON string of monthly breakdown

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  borrower Borrower @relation(fields: [borrowerId], references: [id])
}

// ==================== COLLATERAL & SECURITY ====================

// Collateral information
// CollateralType: LAP | MACHINERY | INVOICE | STOCK | FD | NONE
model Collateral {
  id                   String    @id @default(cuid())
  applicationId        String    @unique
  collateralType       String
  description          String?
  assessedValue        Float
  ltv                  Float // LTV limit percentage (0-100)
  collateralCap        Float // Calculated: assessedValue * (ltv/100)
  hasPersonalGuarantee Boolean   @default(false)
  guarantorName        String?
  guarantorRelation    String?
  valuationDate        DateTime?
  valuationAgency      String?
  documentReference    String?
  remarks              String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  application LoanApplication @relation(fields: [applicationId], references: [id])
}

// ==================== CREDIT DECISION ====================

// Credit decision with explainability
// Decision: APPROVE | REFER | REJECT
model CreditDecision {
  id            String @id @default(cuid())
  applicationId String @unique

  // Scoring
  creditScore Int // 0-100
  decision    String

  // Eligibility amounts
  cashFlowEligible    Float
  collateralEligible  Float
  finalRecommendedAmt Float

  // Score breakdown (JSON)
  scoreBreakdown String? // JSON with component scores

  // Explanations (JSON arrays as strings)
  approvalReasons String? // JSON array of approval reasons
  riskFlags       String? // JSON array of risk flags
  recommendations String? // JSON array of recommendations

  // Calculation inputs (JSON)
  calculationInputs String? // JSON with all inputs used

  // Exact policy version the decision was made under
  policyId String?

  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  application LoanApplication @relation(fields: [applicationId], references: [id])
  policy      CreditPolicy?   @relation(fields: [policyId], references: [id])
}

// ==================== APPROVAL & AUDIT ====================

// NBFC final approval/sanction
// Decision: APPROVE | REFER | REJECT
model Approval {
  id            String @id @default(cuid())
  applicationId String @unique
  approvedBy    String

  // Decision
  finalDecision  String
  overrideSystem Boolean @default(false)
  overrideReason String?

  // Sanction details
  sanctionedAmount Float?
  sanctionedTenure Int? // Months
  interestRate     Float? // Annual %
  processingFee    Float?

  // Conditions
  conditions String? // JSON array of conditions

  approvedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Maker-checker. Status: CONFIRMED | PENDING_CHECKER | RETURNED
  status         String    @default("CONFIRMED")
  checkerReasons Json? // Why a checker was required (from the credit policy)
  checkedBy      String?
  checkedAt      DateTime?
  checkerRemarks String?

  application LoanApplication @relation(fields: [applicationId], references: [id])
  user        User            @relation("ApprovalMaker", fields: [approvedBy], references: [id])
  checker     User?           @relation("ApprovalChecker", fields: [checkedBy], references: [id])
}

// Audit trail
// Exactly one of userId / apiKeyId identifies who acted.
model AuditLog {
  id            String   @id @default(cuid())
  applicationId String?
  userId        String?
  apiKeyId      String?
  action        String
  details       String? // JSON with action details
  ipAddress     String?
  userAgent     String?
  timestamp     DateTime @default(now())

  application LoanApplication? @relation(fields: [applicationId], references: [id])
  user        User?            @relation(fields: [userId], references: [id])
  apiKey      ApiKey?          @relation(fields: [apiKeyId], references: [id])
}

// ==================== CREDIT POLICY ====================

// Versioned credit policy (see policies/*.yaml and packages/engine/src/policy.ts).
// Rows are immutable: changing a policy means adding a new version and activating it,
// so every past decision can be traced to, and re-run under, the policy it used.
model CreditPolicy {
  id          String    @id @default(cuid())
  nbfcId      String
  policyKey   String // `id` field of the policy document
  name        String
  version     String
  document    String // Validated policy JSON
  checksum    String // SHA-256 of the canonical document
  isActive    Boolean   @default(false)
  activatedAt DateTime?
  createdBy   String? // User id, or null when applied from the CLI
  createdAt   DateTime  @default(now())

  nbfc      NBFC             @relation(fields: [nbfcId], references: [id])
  decisions CreditDecision[]

  @@unique([nbfcId, policyKey, version])
  @@index([nbfcId, isActive])
}

// ==================== PUBLIC API ====================

// API key for the public /api/v1 API. Only a SHA-256 hash of the secret is stored;
// the full key is shown once at creation. Format: cf_<prefix>_<secret>
model ApiKey {
  id          String    @id @default(cuid())
  nbfcId      String
  name        String
  prefix      String    @unique
  keyHash     String    @unique
  scopes      String[]
  createdById String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  nbfc      NBFC       @relation(fields: [nbfcId], references: [id])
  createdBy User?      @relation(fields: [createdById], references: [id])
  auditLogs AuditLog[]
}

// Stored responses for POST requests sent with an Idempotency-Key header,
// so a retried request returns the original result instead of creating a duplicate.
model IdempotencyKey {
  id             String   @id @default(cuid())
  nbfcId         String
  key            String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())

  nbfc NBFC @relation(fields: [nbfcId], references: [id])

  @@unique([nbfcId, key])
}

// ==================== WEBHOOKS ====================

model WebhookEndpoint {
  id          String   @id @default(cuid())
  nbfcId      String
  url         String
  description String?
  secret      String // Used to sign deliveries (HMAC-SHA256)
  events      String[] // Event types, or ["*"] for all
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  nbfc       NBFC              @relation(fields: [nbfcId], references: [id])
  deliveries WebhookDelivery[]
}

// Every event is recorded (outbox), whether or not any endpoint subscribes to it.
model WebhookEvent {
  id        String   @id @default(cuid())
  nbfcId    String
  type      String
  data      Json
  createdAt DateTime @default(now())

  nbfc       NBFC              @relation(fields: [nbfcId], references: [id])
  deliveries WebhookDelivery[]

  @@index([nbfcId, createdAt])
}

// Status: PENDING | SUCCEEDED | FAILED (gave up after max attempts)
model WebhookDelivery {
  id             String    @id @default(cuid())
  endpointId     String
  eventId        String
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lastAttemptAt  DateTime?
  responseStatus Int?
  lastError      String?
  createdAt      DateTime  @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event    WebhookEvent    @relation(fields: [eventId], references: [id])

  @@unique([endpointId, eventId])
  @@index([status, nextAttemptAt])
}
